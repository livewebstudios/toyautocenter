# Formspree form ID (the part after /f/ in the endpoint). Booking form posts to https://formspree.io/f/<id>
# Defaults to the shop's form (xljjlyoe) in src/data/site.ts; set this only to override it.
PUBLIC_FORMSPREE_ID=xljjlyoe
# Google Analytics 4 measurement ID. Defaults to the shop's existing property (G-KSH0KJ15GJ, same one the old site used).
PUBLIC_GA4_ID=G-KSH0KJ15GJ
