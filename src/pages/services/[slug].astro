---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import KeyMark from '../../components/KeyMark.astro';
import FAQ from '../../components/FAQ.astro';
import Divider from '../../components/Divider.astro';
import Harness from '../../islands/HarnessBackground';
import { services, serviceBySlug, pad } from '../../data/services';
import { towns } from '../../data/towns';
import { site } from '../../data/site';
import { serviceCopy } from '../../lib/content';
import { inline, splitLong } from '../../lib/inline';
import { rel } from '../../lib/paths';
import { serviceNode, faqNode, oilOfferNode } from '../../lib/schema';
import { getImage } from 'astro:assets';
import { wide, HERO_WIDTHS, HERO_SIZES } from '../../lib/images';
import HeroBg from '../../components/HeroBg.astro';
import Band from '../../components/Band.astro';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params as { slug: string };
const svc = serviceBySlug(slug);
const c = serviceCopy(slug);
const path = `/services/${slug}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: svc.name, path },
];
const related = svc.related.map(serviceBySlug);
const md = (s: string) => inline(s, Astro.url);
const isOil = slug === 'oil-change-maintenance';
const schema = [
  serviceNode({ path, name: svc.name, serviceType: svc.serviceType, description: c.description, offer: isOil ? oilOfferNode(path) : undefined }),
  faqNode(path, c.faqs),
];
const shortName = svc.short;
// Services without their own photo borrow the closest match for the hero background.
const fallbackHero: Record<string, string> = {
  'oil-change-maintenance': 'mechanic-hands-wrench-workbench',
  'engine-repair': 'serpentine-belt-replacement',
  'fuel-system': 'hero-shop-bay-blauvelt',
  'battery-electrical': 'obd2-diagnostic-scan-tool',
  'exhaust-air-intake': 'nys-inspection-underbody-check',
};
const heroKey = svc.image ?? fallbackHero[slug] ?? 'hero-shop-bay-blauvelt';
const heroImg = wide(heroKey);
const heroAvif = await getImage({ src: heroImg, widths: HERO_WIDTHS.filter((w) => w <= heroImg.width), format: 'avif', quality: 42 });
const preload = { srcset: heroAvif.srcSet.attribute, sizes: HERO_SIZES, type: 'image/avif' };
// Bands alternate light / dark in render order.
let bandN = 0;
const tone = (): 'light' | 'dark' => (bandN++ % 2 ? 'dark' : 'light');
---
<Base title={c.title} description={c.description} crumbs={crumbs.slice(1)} schema={schema} speakable={slug === 'nys-inspection'} ctaSeed={svc.n * 131} preload={preload}>
  <section class="svc-hero photo-hero on-dark" aria-labelledby="svc-title">
    <HeroBg image={heroKey} />
    <div class="container svc-hero__grid">
      <div class="svc-hero__text">
        <Breadcrumbs items={crumbs} tone="dark" />
        <p class="svc-hero__num mono"><span class="led" aria-hidden="true"></span>SERVICE {pad(svc.n)} / 13</p>
        <h1 id="svc-title">{c.h1}</h1>
        <p class="lead svc-hero__promise" data-speakable>{c.promise}</p>
        <div class="btn-row">
          <Button href="/contact/">BOOK AN APPOINTMENT</Button>
          <a class="btn btn--ghost" href={`tel:${site.phone.tel}`}>CALL {site.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  <Band tone={tone()} label="Overview" seed={svc.n * 7} art="car">
    <div class="svc-intro" slot="head">
      <p class="eyebrow">{shortName.toUpperCase()}</p>
      <p class="svc-intro__lead" set:html={md(c.intro[0])} />
    </div>
    {c.intro.slice(1).flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
    <div class="svc-help">
      <ServiceIcon name={svc.icon} size={56} />
      <div>
        <p class="svc-help__title">Not sure what you need?</p>
        <p>Describe what the car is doing. We find the cause first and call before any repair.</p>
      </div>
    </div>
  </Band>

  <Band tone={tone()} eyebrow="SYMPTOMS" heading={c.symptomsHeading} headingId="sym-h" seed={svc.n * 11} art="scope">
    <ul class="symptoms">
      {c.symptoms.map((s) => (
        <li data-reveal>
          <p class="symptoms__feel" set:html={md(s.feel)} />
          <p class="symptoms__means"><span class="symptoms__tag">LIKELY CAUSE</span> <span set:html={md(s.means)} /></p>
        </li>
      ))}
    </ul>
  </Band>

  <Band tone={tone()} eyebrow="WHAT WE CHECK" heading={c.checkHeading} headingId="chk-h" seed={svc.n * 13} art="checklist">
    {c.checkIntro && <p slot="head" set:html={md(c.checkIntro)} />}
    <ol class="checks">{c.checks.map((x) => <li data-reveal set:html={md(x)} />)}</ol>
  </Band>

  <Band tone={tone()} eyebrow="WHAT WE FIX" heading={c.fixHeading} headingId="fix-h" seed={svc.n * 17} art="wrench">
    <div class="fixes">
      {c.fixes.map((g) => (
        <div class="fixes__group" data-reveal>
          <h3>{g.title}</h3>
          <dl>
            {g.items.map((it) => (
              <div><dt>{it.name}</dt><dd set:html={md(it.note)} /></div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </Band>

  {c.table && (
    <Band tone={tone()} eyebrow="AT A GLANCE" heading={c.table.caption} headingId="tbl-h" seed={svc.n * 19} art="gauge">
      <div class="table-wrap" tabindex="0" role="region" aria-label={`${c.table.caption}, scrolls sideways`}>
        <table class="data-table">
          <thead><tr>{c.table.columns.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {c.table.rows.map((r) => (
              <tr>
                <th scope="row">{r[0]}</th>
                {r.slice(1).map((cell) => <td class:list={[cell && 'tick']}>{cell ? cell : <span class="visually-hidden">Not scheduled</span>}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Band>
  )}

  {c.extra?.map((b, i) => (
    <Band tone={tone()} eyebrow="GOOD TO KNOW" heading={b.heading} headingId={`ex-h-${i}`} seed={svc.n * 23 + i} art="gears">
      {b.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
    </Band>
  ))}

  {c.techie && (
    <Band tone={tone()} eyebrow="FOR THE CURIOUS" heading={c.techie.heading} headingId="tech-h" seed={svc.n * 29} art="gears">
      {c.techie.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
    </Band>
  )}

  {c.toyota && (
    <Band tone={tone()} eyebrow="TOYOTA & LEXUS" heading={c.toyota.heading} headingId="toy-h" seed={svc.n * 31} art="key">
      <KeyMark variant="solid" size={44} slot="head" class="svc-key" />
      {c.toyota.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
      <p><a class="link-arrow" href={rel(Astro.url, '/toyota-lexus-repair/')}>TOYOTA &amp; LEXUS SPECIALISTS</a></p>
    </Band>
  )}

  <Band tone={tone()} eyebrow="FAQ" heading={`${shortName} questions, answered`} headingId="faq-h" seed={svc.n * 37} art="chat">
    <p slot="head" set:html={md(c.closing)} />
    <FAQ items={c.faqs} />
  </Band>

  <Band tone={tone()} eyebrow="KEEP GOING" heading="Related services" headingId="rel-h" seed={svc.n * 41} art="route">
    <ul class="related" data-live-icons>
      {related.map((r) => (
        <li>
          <a href={rel(Astro.url, `/services/${r.slug}/`)}>
            <ServiceIcon name={r.icon} size={40} />
            <span><span class="mono related__n">{pad(r.n)}</span>{r.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="serving-label">Serving</p>
    <ul class="serving">
      {towns.map((t) => <li><a href={rel(Astro.url, `/service-area/${t.slug}/`)}>{t.name}</a></li>)}
    </ul>
  </Band>
</Base>

<style>
  .svc-hero__grid { position: relative; z-index: 1; }
  .svc-hero__text { display: grid; gap: var(--s-5); justify-items: start; max-width: 640px; }
  .svc-hero__num { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--tac-amber); font-weight: 600; letter-spacing: 0.1em; margin-top: var(--s-4); }
  .svc-hero h1 { font-size: var(--fs-h1-inner); max-width: 16ch; }
  .svc-hero__promise { max-width: 44ch; }

  .svc-intro__lead { margin-top: var(--s-3); font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem); line-height: 1.45; font-weight: 600; letter-spacing: -0.01em; color: var(--tac-purple); max-width: 34ch; }
  :global(.band--dark) .svc-intro__lead { color: var(--tac-white); }
  .svc-help { display: grid; grid-template-columns: 56px 1fr; gap: var(--s-4); align-items: center; padding: var(--s-5); border-radius: var(--r-3); background: var(--tac-white); border: 1px solid var(--tac-line); box-shadow: var(--tac-shadow-1); }
  .svc-help__title { font-weight: 750; color: var(--tac-purple); font-size: 1.125rem; }
  .svc-help p + p { margin-top: var(--s-1); color: var(--tac-ink-soft); font-size: var(--fs-small); }

  .symptoms { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .symptoms li { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-5); border-radius: var(--r-2); background: var(--tac-white); border: 1px solid var(--tac-line); }
  .symptoms__feel { font-weight: 700; font-size: 1.0625rem; color: var(--tac-ink); }
  .symptoms__means { color: var(--tac-ink-soft); }
  .symptoms__tag { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--tac-violet-deep); font-weight: 600; letter-spacing: 0.1em; margin-right: var(--s-1); }
  :global(.band--dark) .symptoms li { background: var(--tac-white-08); border-color: var(--tac-white-12); }
  :global(.band--dark) .symptoms__feel { color: var(--tac-white); }
  :global(.band--dark) .symptoms__means { color: var(--tac-on-dark-soft); }
  :global(.band--dark) .symptoms__tag { color: var(--tac-amber); }

  .checks { list-style: none; padding: 0; display: grid; gap: var(--s-3); counter-reset: chk; }
  @media (min-width: 640px) { .checks { grid-template-columns: 1fr 1fr; } }
  .checks li { counter-increment: chk; display: grid; grid-template-columns: 2.25rem 1fr; gap: var(--s-3); align-items: center; padding: var(--s-3) var(--s-4); border-radius: var(--r-2); background: var(--tac-white); border: 1px solid var(--tac-line); font-weight: 600; color: var(--tac-ink); line-height: 1.35; }
  .checks li::before { content: counter(chk, decimal-leading-zero); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--tac-white); background: var(--tac-purple); border-radius: var(--r-pill); width: 2.25rem; height: 1.75rem; display: grid; place-items: center; }
  :global(.band--dark) .checks li { background: var(--tac-white-08); border-color: var(--tac-white-12); color: var(--tac-white); }
  :global(.band--dark) .checks li::before { background: var(--tac-amber); color: var(--tac-graphite); }

  .fixes { display: grid; gap: var(--s-8); }
  @media (min-width: 720px) { .fixes { grid-template-columns: 1fr 1fr; } }
  .fixes__group h3 { font-size: 1.25rem; padding-bottom: var(--s-3); border-bottom: 2px solid var(--tac-purple); margin-bottom: var(--s-2); }
  .fixes__group dl div { padding: var(--s-3) 0; border-bottom: 1px solid var(--tac-line); }
  .fixes__group dt { font-weight: 700; color: var(--tac-ink); }
  .fixes__group dd { margin: var(--s-1) 0 0; color: var(--tac-ink-soft); font-size: 0.9375rem; }
  :global(.band--dark) .fixes__group h3 { border-color: var(--tac-amber); }
  :global(.band--dark) .fixes__group dl div { border-color: var(--tac-white-12); }
  :global(.band--dark) .fixes__group dt { color: var(--tac-white); }
  :global(.band--dark) .fixes__group dd { color: var(--tac-on-dark-soft); }

  .svc-key { margin-top: var(--s-4); }

  .related { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .related { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .related a > span { min-width: 0; overflow-wrap: anywhere; }
  .related a { display: grid; grid-template-columns: 40px 1fr; gap: var(--s-3); align-items: center; padding: var(--s-4); border-radius: var(--r-2); text-decoration: none; color: var(--tac-ink); font-weight: 700; line-height: 1.25; background: var(--tac-white); border: 1px solid var(--tac-line); transition: transform var(--dur-2) var(--ease-out), border-color var(--dur-2); }
  .related a:hover { color: var(--tac-purple); border-color: var(--tac-violet); transform: translateY(-2px); }
  .related__n { display: block; font-size: 0.6875rem; color: var(--tac-violet-deep); }
  :global(.band--dark) .related a { background: var(--tac-white-08); border-color: var(--tac-white-12); color: var(--tac-white); }
  :global(.band--dark) .related a:hover { border-color: var(--tac-amber); color: var(--tac-white); }
  :global(.band--dark) .related__n { color: var(--tac-amber); }
  .serving-label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tac-violet-deep); }
  :global(.band--dark) .serving-label { color: var(--tac-amber); }
  .serving { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .serving a { display: inline-flex; align-items: center; min-height: 32px; padding: var(--s-1) var(--s-3); border-radius: var(--r-pill); background: var(--tac-white); border: 1px solid var(--tac-line); font-size: 0.875rem; text-decoration: none; color: var(--tac-purple); }
  .serving a:hover { background: var(--tac-purple); color: var(--tac-white); }
  :global(.band--dark) .serving a { background: var(--tac-white-08); border-color: var(--tac-white-12); color: var(--tac-white); }
  :global(.band--dark) .serving a:hover { background: var(--tac-white); color: var(--tac-grape); }
</style>
