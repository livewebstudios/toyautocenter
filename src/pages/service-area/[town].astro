---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import AreaMap from '../../components/AreaMap.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import FAQ from '../../components/FAQ.astro';
import Divider from '../../components/Divider.astro';
import { towns, townBySlug } from '../../data/towns';
import { serviceBySlug, pad } from '../../data/services';
import { site } from '../../data/site';
import { townCopyOf, serviceCopy } from '../../lib/content';
import { inline, splitLong } from '../../lib/inline';
import { rel, abs } from '../../lib/paths';
import { businessNode, faqNode, BUSINESS_ID } from '../../lib/schema';

export function getStaticPaths() {
  return towns.map((t) => ({ params: { town: t.slug } }));
}
const { town: slug } = Astro.params as { town: string };
const t = townBySlug(slug);
const c = townCopyOf(slug);
const path = `/service-area/${slug}/`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Service Area', path: '/service-area/' }, { name: t.name, path }];
const md = (s: string) => inline(s, Astro.url);
const svcs = c.serviceLinks.map(serviceBySlug);
const neighbors = towns.filter((x) => x.slug !== slug);

// Town node: same shop, areaServed limited to this town, @id suffixed by the town.
const base = businessNode({ logo: abs('/icon-512.png'), image: [abs('/icon-512.png')] });
const townNode = {
  '@type': 'AutoRepair',
  '@id': `${BUSINESS_ID}-${slug}`,
  name: `${site.name} for ${t.name} drivers`,
  url: abs(path),
  parentOrganization: { '@id': BUSINESS_ID },
  telephone: base.telephone,
  address: base.address,
  geo: base.geo,
  priceRange: '$$',
  openingHoursSpecification: base.openingHoursSpecification,
  areaServed: t.places.map((p) => ({ '@type': 'Place', name: `${p.name}, ${p.region}` })),
  image: abs('/icon-512.png'),
};
---
<Base title={c.title} description={c.description} crumbs={crumbs.slice(1)} schema={[townNode, faqNode(path, c.faqs)]} ctaSeed={t.map.x * 3 + t.map.y}>
  <PageHero crumbs={crumbs} eyebrow={`${t.name.toUpperCase()}${t.places[0].region === 'NJ' ? ', NJ' : ', NY'} · ${c.route.driveTime.toUpperCase()} TO THE SHOP`} title={c.h1} lead={md(c.intro[0])} seed={t.map.x * 7 + t.map.y}>
    <AreaMap compact title={`Map from ${t.name} to Toy Auto Center on Route 303 in Blauvelt`} />
    <Fragment slot="actions">
      <div class="btn-row">
        <Button href="/contact/">BOOK AN APPOINTMENT</Button>
        <a class="btn btn--ghost" href={site.links.directions} rel="noopener">GET DIRECTIONS</a>
      </div>
    </Fragment>
  </PageHero>

  <div class="container town-body">
    <article class="town-main">
      <section class="flow" aria-label="Overview">{c.intro.slice(1).flatMap(splitLong).map((p) => <p class="lead" set:html={md(p)} />)}</section>

      <section class="route" aria-labelledby="route-h" data-reveal>
        <div class="route__head">
          <p class="eyebrow">THE DRIVE</p>
          <h2 id="route-h">{c.route.heading}</h2>
          <p class="route__time mono"><span class="led" aria-hidden="true"></span>{c.route.driveTime}</p>
        </div>
        <ol class="readout-list">{c.route.steps.map((s) => <li set:html={md(s)} />)}</ol>
        <div class="flow route__body">{c.route.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}</div>
      </section>

      {c.sections.map((s) => (
        <section class="flow town-sec" aria-label={s.heading}>
          <h2>{s.heading}</h2>
          {s.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
        </section>
      ))}

      <section class="insp" aria-labelledby="insp-h" data-reveal>
        <p class="eyebrow">INSPECTION</p>
        <h2 id="insp-h">{c.inspectionNote.heading}</h2>
        {c.inspectionNote.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
      </section>

      <section aria-labelledby="ts-h">
        <h2 id="ts-h" class="ts-h">What {t.name} drivers book most</h2>
        <ul class="town-svcs" data-live-icons>
          {svcs.map((s) => (
            <li>
              <a href={rel(Astro.url, `/services/${s.slug}/`)}>
                <ServiceIcon name={s.icon} size={52} />
                <span class="mono town-svcs__n">{pad(s.n)}</span>
                <span class="town-svcs__name">{s.name}</span>
                <span class="town-svcs__p">{serviceCopy(s.slug).promise}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="tf-h">
        <h2 id="tf-h" class="ts-h">{t.name} questions</h2>
        <FAQ items={c.faqs} />
      </section>
    </article>
    <aside class="town-aside" aria-label="More towns">
      <div class="aside-box">
        <h2 class="aside-box__h">Other towns we serve</h2>
        <ul>{neighbors.map((n) => <li><a href={rel(Astro.url, `/service-area/${n.slug}/`)}>{n.name}</a></li>)}</ul>
        <a class="link-arrow" href={rel(Astro.url, '/service-area/')}>Full service area</a>
      </div>
    </aside>
  </div>
  <Divider />
</Base>
<style>
  .town-body { display: grid; gap: var(--s-16); padding-block: var(--s-16) var(--section-y); }
  @media (min-width: 1100px) { .town-body { grid-template-columns: minmax(0, 1fr) 280px; gap: var(--s-20); } .town-aside { position: sticky; top: calc(var(--nav-h) + var(--s-6)); align-self: start; } }
  .town-main { display: grid; gap: var(--s-16); min-width: 0; }
  .route { display: grid; gap: var(--s-6); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border: 1px solid var(--tac-line); border-radius: var(--r-3); background: var(--tac-white); }
  .route__head { display: grid; gap: var(--s-2); }
  .route__time { display: inline-flex; gap: var(--s-2); align-items: center; font-weight: 600; color: var(--tac-violet-deep); text-transform: uppercase; letter-spacing: 0.08em; }
  .town-sec h2, .insp h2 { max-width: 22ch; }
  .insp { display: grid; gap: var(--s-4); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); background: var(--tac-mist); border-radius: var(--r-3); border-left: 4px solid var(--tac-amber); }
  .ts-h { margin-bottom: var(--s-6); }
  .town-svcs { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  @media (min-width: 720px) { .town-svcs { grid-template-columns: repeat(3, 1fr); } }
  .town-svcs a { display: grid; gap: var(--s-2); height: 100%; padding: var(--s-5); border: 1px solid var(--tac-line); border-radius: var(--r-3); background: var(--tac-white); text-decoration: none; color: var(--tac-ink); transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2); }
  .town-svcs a:hover { transform: translateY(-2px); box-shadow: var(--tac-shadow-2); color: var(--tac-ink); }
  .town-svcs__n { font-size: 0.75rem; color: var(--tac-violet-deep); }
  .town-svcs__name { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--tac-purple); line-height: 1.05; }
  .town-svcs__p { font-size: 0.875rem; color: var(--tac-ink-soft); }
  .aside-box { padding: var(--s-6); border: 1px solid var(--tac-line); border-radius: var(--r-3); background: var(--tac-white); display: grid; gap: var(--s-4); }
  .aside-box__h { font-size: 1.375rem; }
  .aside-box ul { list-style: none; padding: 0; display: grid; gap: var(--s-1); }
  .aside-box a { text-decoration: none; }
  .aside-box a:hover { text-decoration: underline; }
</style>
