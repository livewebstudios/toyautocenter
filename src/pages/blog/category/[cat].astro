---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogFilter from '../../../islands/BlogFilter';
import { blog as copy } from '../../../data/pages/misc';
import { postCards, categoryLinks } from '../../../lib/blogcards';
import { allPosts, catSlug } from '../../../lib/posts';
import { rel } from '../../../lib/paths';

export function getStaticPaths() {
  const cats = [...new Set(allPosts().map((p) => p.category))];
  return cats.map((c) => ({ params: { cat: catSlug(c) }, props: { name: c } }));
}
const { name } = Astro.props as { name: string };
const slug = catSlug(name);
const path = `/blog/category/${slug}/`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name, path }];
const count = allPosts().filter((p) => p.category === name).length;
const title = `${name} Articles | Toy Auto Center Blog, Blauvelt NY`;
const description = `${name} articles from Toy Auto Center in Blauvelt, NY: ${count} plain-English ${count === 1 ? 'post' : 'posts'} from our Route 303 shop for Rockland County drivers and car owners.`;
import { heroPreload } from '../../../lib/images';
const heroPre = await heroPreload('serpentine-belt-replacement');
---
<Base title={title} description={description} crumbs={crumbs.slice(1)} pageType="CollectionPage" ctaSeed={slug.length * 31} preload={heroPre}>
  <PageHero crumbs={crumbs} eyebrow="THE SHOP BLOG" title={`${name} posts`} lead={copy.categoryIntro(name)} image="serpentine-belt-replacement" />
  <section class="section section--tight">
    <div class="container">
      <BlogFilter client:visible posts={postCards(Astro.url)} categories={categoryLinks(Astro.url)} allHref={rel(Astro.url, '/blog/')} active={slug} />
    </div>
  </section>
</Base>
