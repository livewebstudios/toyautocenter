---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import Button from '../components/Button.astro';
import KeyMark from '../components/KeyMark.astro';
import copy from '../data/pages/about';
import { site } from '../data/site';
import { inline, splitLong } from '../lib/inline';

const path = '/about/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path }];
const md = (s: string) => inline(s, Astro.url);
const [shop, estimate, ...cards] = copy.sections;
const facts = [
  { k: 'EST.', v: String(site.founded) },
  { k: 'OWNERSHIP', v: 'Family owned' },
  { k: 'INSPECTIONS', v: 'NYS certified station' },
  { k: 'SPECIALTY', v: 'Toyota · Lexus · Scion' },
  { k: 'ALSO', v: 'All makes and models' },
  { k: 'TRANSMISSIONS', v: 'Jasper, 3 yr / 100k' },
];
import { heroPreload } from '../lib/images';
const heroPre = await heroPreload('mechanic-hands-wrench-workbench');
---
<Base title={copy.title} description={copy.description} crumbs={crumbs.slice(1)} pageType="AboutPage" ctaSeed={1976} preload={heroPre}>
  <PageHero crumbs={crumbs} eyebrow={`FAMILY OWNED · BLAUVELT, NY · SINCE ${site.founded}`} title={copy.h1} seed={1976} image="mechanic-hands-wrench-workbench">
    <Fragment slot="actions"><Button href="/contact/">BOOK AN APPOINTMENT</Button></Fragment>
  </PageHero>

  <Band tone="light" eyebrow="THE SHOP" heading={shop.heading} headingId="ab-shop" seed={1976} art="shop">
    {shop.body.flatMap(splitLong).map((p, i) => <p class:list={[i === 0 && 'lead']} set:html={md(p)} />)}
    <dl class="facts">
      {facts.map((f) => <div data-reveal><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
    </dl>
  </Band>

  <Band tone="dark" eyebrow="NO SURPRISES" heading={estimate.heading} headingId="ab-est" seed={77} art="phone">
    <ol class="steps">
      {estimate.body.map((p) => <li data-reveal set:html={md(p)} />)}
    </ol>
  </Band>

  <Band tone="light" split={false} label="More about the shop" seed={303}>
    <div class="cards">
      {cards.map((c, i) => (
        <section class="card" aria-labelledby={`ab-c${i}`} data-reveal>
          <h2 id={`ab-c${i}`}>{c.heading}</h2>
          {c.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
        </section>
      ))}
    </div>
  </Band>

  <Band tone="dark" eyebrow="OUR WORD" heading={copy.pledgeHeading} headingId="pledge-h" seed={1313} art="shield">
    <KeyMark variant="solid" size={56} slot="head" class="pledge-key" />
    <ol class="pledge">{copy.pledge.map((p) => <li data-reveal>{p}</li>)}</ol>
  </Band>
</Base>
<style>
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-3); margin-top: var(--s-6); }
  @media (min-width: 720px) { .facts { grid-template-columns: repeat(3, 1fr); } }
  .facts div { padding: var(--s-4); border-radius: var(--r-2); background: var(--tac-white); border: 1px solid var(--tac-line); }
  .facts dt { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; color: var(--tac-violet-deep); }
  .facts dd { margin: var(--s-1) 0 0; font-weight: 750; color: var(--tac-purple); line-height: 1.25; }

  .steps { list-style: none; padding: 0; display: grid; gap: var(--s-3); counter-reset: st; }
  @media (min-width: 640px) { .steps { grid-template-columns: 1fr 1fr; } }
  .steps li { counter-increment: st; padding: var(--s-5); border-radius: var(--r-2); background: var(--tac-white-08); border: 1px solid var(--tac-white-12); color: var(--tac-on-dark-soft); }
  .steps li::before { content: counter(st, decimal-leading-zero); display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--tac-amber); margin-bottom: var(--s-2); }
  .steps li :global(strong) { display: block; color: var(--tac-white); font-size: 1.0625rem; margin-bottom: var(--s-1); }

  .cards { display: grid; gap: var(--s-4); }
  @media (min-width: 900px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .card { padding: var(--s-6); border-radius: var(--r-3); background: var(--tac-white); border: 1px solid var(--tac-line); box-shadow: var(--tac-shadow-1); display: grid; gap: var(--s-3); align-content: start; }
  .card h2 { font-size: var(--fs-h3); }
  .card p { color: var(--tac-ink-soft); }

  .pledge-key { margin-top: var(--s-5); }
  .pledge { list-style: none; padding: 0; display: grid; gap: var(--s-3); counter-reset: pl; }
  @media (min-width: 640px) { .pledge { grid-template-columns: 1fr 1fr; } }
  .pledge li { counter-increment: pl; padding: var(--s-5); border-radius: var(--r-2); background: var(--tac-white-08); border: 1px solid var(--tac-white-12); color: var(--tac-white); font-weight: 600; }
  .pledge li::before { content: counter(pl, decimal-leading-zero); display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--tac-amber); margin-bottom: var(--s-2); }
</style>
