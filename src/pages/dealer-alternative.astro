---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import Divider from '../components/Divider.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import copy from '../data/pages/dealer-alternative';
import { inline, splitLong } from '../lib/inline';
import { faqNode } from '../lib/schema';

const path = '/dealer-alternative/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Dealer Alternative', path }];
const md = (s: string) => inline(s, Astro.url);
import { heroPreload } from '../lib/images';
const heroPre = await heroPreload('wheel-alignment-rack-strut');
---
<Base title={copy.title} description={copy.description} crumbs={crumbs.slice(1)} schema={[faqNode(path, copy.faqs)]} ctaSeed={618} preload={heroPre}>
  <PageHero crumbs={crumbs} eyebrow="INDEPENDENT VS. DEALER · ROUTE 303" title={copy.h1} lead={md(copy.intro[0])} seed={618} image="wheel-alignment-rack-strut">
    <Fragment slot="actions"><Button href="/contact/">BOOK AN APPOINTMENT</Button></Fragment>
  </PageHero>

  <Band tone="light" label="Dealer and independent strengths" split={false} seed={618}>
    <p class="lead da-intro" set:html={md(copy.intro[1])} />
    <div class="two-col">
      {[copy.dealerDoesWell, copy.independentDoesBetter].map((b, i) => (
        <div class:list={['col-card', i === 1 && 'col-card--us']} data-reveal>
          <p class="eyebrow">{i === 0 ? 'GO TO THE DEALER FOR' : 'COME TO US FOR'}</p>
          <h2>{b.heading}</h2>
          {b.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}
        </div>
      ))}
    </div>
  </Band>

  <Band tone="dark" eyebrow="SIDE BY SIDE" heading={copy.comparison.heading} headingId="cmp-h" seed={619}>
    <p slot="head" set:html={md(copy.pricingNote)} />
    <div class="table-wrap" tabindex="0" role="region" aria-label={`${copy.comparison.caption}, scrolls sideways`}>
      <table class="data-table cmp">
        <caption class="visually-hidden">{copy.comparison.caption}</caption>
        <thead><tr>{copy.comparison.columns.map((h, i) => <th scope="col">{i === 0 ? <span class="visually-hidden">Topic</span> : h}</th>)}</tr></thead>
        <tbody>{copy.comparison.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td class="cmp__us">{r[2]}</td></tr>)}</tbody>
      </table>
    </div>
  </Band>

  <Band tone="light" eyebrow="FAIR QUESTIONS" heading={copy.closing.heading} headingId="close-h" seed={620}>
    <div slot="head" class="da-close">{copy.closing.body.flatMap(splitLong).map((p) => <p set:html={md(p)} />)}</div>
    <FAQ items={copy.faqs} />
  </Band>
</Base>
<style>
  .da-intro { max-width: 60ch; margin-bottom: var(--s-8); }
  .two-col { display: grid; gap: var(--s-4); }
  @media (min-width: 900px) { .two-col { grid-template-columns: 1fr 1fr; } }
  .col-card { display: grid; gap: var(--s-3); align-content: start; padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); border: 1px solid var(--tac-line); border-radius: var(--r-3); background: var(--tac-white); box-shadow: var(--tac-shadow-1); }
  .col-card--us { border: 2px solid var(--tac-purple); }
  .col-card h2 { font-size: var(--fs-h3); }
  .col-card p:not(.eyebrow) { color: var(--tac-ink-soft); }
  .cmp { min-width: 560px; }
  .cmp td, .cmp th { font-size: 0.875rem; }
  .cmp__us { background: var(--tac-violet-07); color: var(--tac-ink); font-weight: 600; }
  .da-close p { margin-top: var(--s-3); color: var(--tac-ink-soft); }
</style>
