---
// Monospace "readout" strip. Scrolls as a marquee at about 18px/s with no visible loop point (CSS), pauses on hover.
// Reduced motion: static and wrapping.
interface Props { items: string[]; tone?: 'light' | 'dark'; label?: string; static?: boolean }
const { items, tone = 'light', label = 'Shop details', static: isStatic = false } = Astro.props;
const text = items.join('  ·  ');
// duration so speed is ~18px/s: approx 8.4px per mono char at 14px
const seconds = Math.min(150, Math.max(30, Math.round(((text.length + 5) * 8.4) / 18 / 10) * 10));
---
<div class:list={['readout', `readout--${tone}`, `readout--d${seconds}`, isStatic && 'readout--static']} role="group" aria-label={label}>
  <p class="visually-hidden">{items.join(', ')}</p>
  <div class="readout__track" aria-hidden="true">
    <span class="readout__run">{items.map((t) => <span class="readout__item">{t}</span>)}</span>
    {!isStatic && <span class="readout__run">{items.map((t) => <span class="readout__item">{t}</span>)}</span>}
  </div>
</div>
<style>
  .readout {
    overflow: hidden; border-block: 1px solid var(--tac-line);
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--tac-purple); padding-block: var(--s-3);
    mask-image: linear-gradient(90deg, transparent, var(--tac-black) 6%, var(--tac-black) 94%, transparent);
  }
  .readout--dark { border-color: var(--tac-white-18); color: var(--tac-on-dark); }
  .readout__track { display: flex; width: max-content; animation: readout var(--readout-dur, 60s) var(--ease-linear) infinite; }
  .readout--d30 { --readout-dur: 30s; } .readout--d40 { --readout-dur: 40s; } .readout--d50 { --readout-dur: 50s; }
  .readout--d60 { --readout-dur: 60s; } .readout--d70 { --readout-dur: 70s; } .readout--d80 { --readout-dur: 80s; }
  .readout--d90 { --readout-dur: 90s; } .readout--d100 { --readout-dur: 100s; } .readout--d110 { --readout-dur: 110s; }
  .readout--d120 { --readout-dur: 120s; } .readout--d130 { --readout-dur: 130s; } .readout--d140 { --readout-dur: 140s; } .readout--d150 { --readout-dur: 150s; }
  .readout:hover .readout__track { animation-play-state: paused; }
  .readout__run { display: flex; flex: none; }
  .readout__item { padding-inline: 1.1em; white-space: nowrap; display: inline-flex; align-items: center; gap: 1.1em; }
  .readout__item::after { content: ''; width: 5px; height: 5px; background: var(--tac-amber); border-radius: 50%; translate: 1.1em 0; }
  .readout--static .readout__track, .readout--static { animation: none; mask-image: none; }
  .readout--static .readout__track { width: auto; flex-wrap: wrap; }
  .readout--static .readout__run { flex-wrap: wrap; row-gap: var(--s-2); }
  @keyframes readout { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .readout { mask-image: none; }
    .readout__track { animation: none; width: auto; }
    .readout__run { flex-wrap: wrap; row-gap: var(--s-2); }
    .readout__run + .readout__run { display: none; }
  }
</style>
